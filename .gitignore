# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Local Claude Code state stays out; project skills are shared process docs.
.claude/*
!.claude/skills/

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/
/blob-report/

# next.js
/.next/
/.next-build/
/out/

# production
/build

# misc
.DS_Store
*.pem
/worktree-dev.log

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env.local
.env*.local
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

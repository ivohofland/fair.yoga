# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Local Claude Code state stays out; project skills are shared process docs.
.claude/*
!.claude/skills/

# Superpowers scratch: subagent ledgers, task briefs, reports, review packages.
/.superpowers/

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/
/blob-report/

# next.js
/.next/
/.next-build/
/out/

# production
/build
# tsconfig.embed.json's outDir, written only by a hand-run `tsc -p tsconfig.embed.json`
/.embed-build/

# misc
.DS_Store
*.pem
/worktree-dev.log

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env.local
.env*.local
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# opencode
.opencode

# gemini & agent customizations
.gemini/
.agents
/.deployed

# generated Prisma client (pnpm exec prisma generate)
/src/generated/

# Nginx site config for fair.yoga on a single VPS.
# The 443 blocks name certificate files that do not exist before the first
# certbot run, and nginx refuses to load a `listen ... ssl` block without
# one — so the certificate comes first, from the port-80 block alone.
# DEPLOYMENT.md §3 has the two steps and the renewal hook.

server {
    listen 80;
    listen [::]:80;
    server_name yourdomain.example;
    # Certbot uses this for the HTTP-01 challenge; everything else → HTTPS.
    location /.well-known/acme-challenge/ { root /var/www/html; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name yourdomain.example;

    ssl_certificate     /etc/letsencrypt/live/yourdomain.example/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/yourdomain.example/privkey.pem;

    # Security headers. next.config.ts sets these and Permissions-Policy
    # on every response the app serves; the CSP comes from the app as well
    # (src/lib/csp.ts). Kept here too as nginx's own copies at the edge.
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Production runs these jobs in-process (src/lib/scheduler.ts). A manual
    # run goes to http://127.0.0.1:3000 from the VPS itself (DEPLOYMENT.md).
    location /api/cron/ { deny all; }

    # Teacher photo uploads. The app refuses above `MAX_PHOTO_BYTES`
    # (`src/lib/teacher-photo-limits.ts`; 8 MB today) itself, in JSON; this
    # limit sits above that so the app, not nginx, is the one answering.
    location ~ ^/api/teachers/[^/]+/photo$ {
        client_max_body_size 10m;
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # The app's rate limiter keys on X-Forwarded-For — always set it.
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Server-sent events: no buffering, long timeouts.
    location /api/notifications/stream {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 24h;
    }
}

# The admin surface (DEPLOYMENT.md, Admin access). Same app process, second
# name: set ADMIN_HOST=admin.yourdomain.example. Omit these two blocks to leave
# the surface off. No photo-upload or SSE locations here; add them if an admin page ever needs them.
server {
    listen 80;
    listen [::]:80;
    server_name admin.yourdomain.example;
    location /.well-known/acme-challenge/ { root /var/www/html; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name admin.yourdomain.example;

    # One certificate carries both names.
    ssl_certificate     /etc/letsencrypt/live/yourdomain.example/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/yourdomain.example/privkey.pem;

    # Optional: restrict to fixed addresses.
    # allow 203.0.113.7;
    # deny all;

    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Cron routes are bearer-secret endpoints; they are not served on this name.
    location /api/cron/ { deny all; }

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

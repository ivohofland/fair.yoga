generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

enum ReminderPref {
  morning_of
  evening_before
  one_hour_before
}

enum PaymentLevel {
  LEVEL_1
  LEVEL_2
}

enum ProcessorType {
  mollie
  stripe
}

enum StudentReminderPref {
  eve
  morning
  one_hour
  off
}

enum CancelDeadline {
  HOURS_48
  HOURS_24
  HOURS_12
  HOURS_6
}

enum AutoCancelCheck {
  HOURS_4
  HOURS_2
  HOURS_1
}

enum ClassStatus {
  draft
  open
  in_progress
  completed
  cancelled
}

enum RegistrationStatus {
  registered
  attended
  no_show
  late_cancel
  cancelled
}

enum WaitlistStatus {
  waiting
  promoted
  claimed
  expired
  removed
}

enum PaymentStatus {
  pending
  paid
  overdue
}

enum RecipientType {
  teacher
  student
}

enum NotificationType {
  booking_confirmed
  class_cancelled
  payment_received
  payment_request
  waitlist_promoted
  spot_available
  reminder
  missed_you
  announcement
  teacher_invitation
}

enum InvitationStatus {
  pending
  accepted
  declined
}

// ============================================================================
// PEOPLE
// ============================================================================

// One account per human: owns the authenticated email identity, sessions,
// and passkeys. Teacher/Student are profiles optionally hanging off it —
// only the two profile-link columns reference Account; everything else in
// the domain keys on teacherId/studentId (auth unifies, domain doesn't).
// Profile email columns are denormalized copies set at link time; live
// linked profiles match the account's email by construction, and there is
// deliberately no email-change flow — adding one must update the account
// and its live linked profiles together, through a single choke point.
model Account {
  id        String   @id @default(uuid())
  email     String   @unique
  createdAt DateTime @default(now())

  teacher Teacher?
  student Student?
}

model Teacher {
  id                 String         @id @default(uuid())
  accountId          String         @unique
  firstName          String
  lastName           String
  email              String         @unique
  photoUrl           String?
  bio                String         @db.VarChar(250)
  pageSlug           String         @unique
  customDomain       String?
  defaultCurrency    String         @default("EUR")
  defaultTimezone    String         @default("Europe/Amsterdam")
  defaultReminder    ReminderPref   @default(morning_of)
  paymentLevel       PaymentLevel   @default(LEVEL_1)
  bankIban           String?
  bankAccountName    String?
  processorType      ProcessorType?
  processorAccountId String?
  deletedAt          DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  account         Account          @relation(fields: [accountId], references: [id])
  teacherRooms    TeacherRoom[]
  classTemplates  ClassTemplate[]
  classes         Class[]
  studioClasses         StudioClass[]
  studioClassTemplates  StudioClassTemplate[]
  announcements   Announcement[]
  studentPrivacy  StudentPrivacy[]
  createdRooms    Room[]           @relation("RoomCreator")
  teacherStudents TeacherStudent[]
  invitations     Invitation[]
  teacherBlocks   TeacherBlock[]
}

model Student {
  id                 String              @id @default(uuid())
  // Nullable: CRM-created students stay unclaimed (claimedAt null) until
  // the human authenticates — the claim moment links the account.
  accountId          String?             @unique
  firstName          String
  lastName           String
  email              String              @unique
  incomeTier         Int                 @default(3)
  phone              String?
  birthday           DateTime?           @db.Date
  address            String?
  reminderPref       StudentReminderPref @default(morning)
  emailNotifications Boolean             @default(true)
  claimedAt          DateTime?
  tierSelectedAt     DateTime?
  deletedAt          DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  account         Account?        @relation(fields: [accountId], references: [id])
  registrations   Registration[]
  waitlistEntries WaitlistEntry[]
  studentPrivacy  StudentPrivacy[]
  teacherStudents TeacherStudent[]
}

model StudentPrivacy {
  id            String   @id @default(uuid())
  studentId     String
  teacherId     String
  shareFullName Boolean  @default(false)
  shareEmail    Boolean  @default(false)
  sharePhone    Boolean  @default(false)
  shareBirthday Boolean  @default(false)
  shareAddress  Boolean  @default(false)
  receiveComms  Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([studentId, teacherId])
}

model TeacherStudent {
  id         String   @id @default(uuid())
  teacherId  String
  studentId  String
  isArchived Boolean  @default(false)
  createdAt  DateTime @default(now())

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([teacherId, studentId])
}

// A teacher's CRM contact and its consent state. Deliberately NOT a
// Student row: POST /api/students must behave identically whether or not
// the address is already on the platform, and it cannot, if it writes to
// a table with a unique email column.
model Invitation {
  id          String           @id @default(uuid())
  teacherId   String
  email       String
  firstName   String           @default("")
  lastName    String           @default("")
  status      InvitationStatus @default(pending)
  isArchived  Boolean          @default(false)
  createdAt   DateTime         @default(now())
  respondedAt DateTime?

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([teacherId, email])
  @@index([email])
}

// A student's standing refusal of one teacher, kept out of `Invitation` on
// purpose. Held here, invitation rows behave identically for a blocked and
// an unblocked address — listed, edited, archived, deleted, re-created — so
// there is no observable difference for a teacher to read. Held *in* the
// invitation row, every one of those operations needs a special case, and
// each is a place the block can be silently lost.
model TeacherBlock {
  id        String   @id @default(uuid())
  teacherId String
  email     String
  createdAt DateTime @default(now())

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([teacherId, email])
}

// ============================================================================
// SPACES
// ============================================================================

/// Carries two partial unique indexes Prisma cannot express and therefore
/// cannot show: `Room_public_identity_unique` on (address, floor, roomName)
/// WHERE isPublic = true, and `Room_private_identity_unique` on
/// (createdById, address, floor, roomName) WHERE isPublic = false (#196).
/// Both are invisible to `migrate diff`, so neither will appear as drift and
/// neither will be dropped — and equally neither will appear in this file
/// unless someone keeps this comment true.
model Room {
  id          String   @id @default(uuid())
  venueName   String
  address     String
  city        String
  postcode    String
  floor       String   @default("")
  roomName    String   @default("")
  maxCapacity Int
  equipment   Json     @default("[]")
  notes       String?  @db.Text
  isPublic    Boolean  @default(true)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy    Teacher       @relation("RoomCreator", fields: [createdById], references: [id])
  teacherRooms TeacherRoom[]

  @@index([address, floor, roomName])
}

model TeacherRoom {
  id               String   @id @default(uuid())
  teacherId        String
  roomId           String
  capacityOverride Int
  rentalRate       Decimal  @db.Decimal(10, 2)
  equipmentNotes   String?  @db.Text
  isArchived       Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  teacher        Teacher         @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  room           Room            @relation(fields: [roomId], references: [id], onDelete: Cascade)
  classTemplates ClassTemplate[]
  classes        Class[]

  @@unique([teacherId, roomId])
}

// ============================================================================
// CLASSES
// ============================================================================

/// Carries a partial unique index Prisma cannot express and therefore cannot
/// show: `ClassTemplate_teacher_slot_unique` on (teacherId, dayOfWeek,
/// startTime) WHERE isArchived = false (#196). It is invisible to `migrate
/// diff`, so it will not appear as drift and will not be dropped — and
/// equally will not appear in this file unless someone keeps this comment
/// true.
model ClassTemplate {
  id              String          @id @default(uuid())
  teacherId       String
  teacherRoomId   String
  classType       String
  description     String?         @db.Text
  dayOfWeek       Int
  startTime       String
  durationMinutes Int
  roomCost        Decimal         @db.Decimal(10, 2)
  minRate         Decimal         @db.Decimal(10, 2)
  targetRate      Decimal         @db.Decimal(10, 2)
  minStudents     Int
  maxStudents     Int
  cancelDeadline  CancelDeadline  @default(HOURS_24)
  autoCancelCheck AutoCancelCheck @default(HOURS_2)
  isActive        Boolean         @default(true)
  isArchived      Boolean         @default(false)

  /// When this template was last archived (#97).
  ///
  /// Null when no archive has recorded one — which is not the same as
  /// `isArchived: false`. `deleteTeacherAccount` (src/services/gdpr.ts) bulk-archives
  /// every template of an erased teacher with an `updateMany` that writes
  /// neither this column nor `withdrawnCount`, so `isArchived: true` with both
  /// null is reachable today, as it is for every template archived before #97
  /// shipped. Read this as "the archive that recorded itself", never as "is it
  /// archived" — `isArchived` answers that.
  ///
  /// Cleared again on un-archive, which forces `isActive: false` in the same
  /// write: what has no withdrawal to report is a template that is no longer
  /// archived, and it is paused at that moment, not live. Re-archiving
  /// overwrites rather than accumulating — a teacher asking what archiving
  /// removed means the archive in force, not every archive this template has
  /// had.
  archivedAt      DateTime?

  /// How many future unbooked classes that same archive withdrew — the
  /// `deleteMany`'s own returned count, written inside its transaction, so it
  /// cannot claim a number the delete did not produce. Null and cleared on
  /// exactly the terms `archivedAt` above describes, which is what keeps a
  /// recorded `0` ("archived, withdrew nothing") distinguishable from no
  /// record at all.
  ///
  /// What is still scheduled is deliberately not stored beside it. The archive
  /// PATCH returns a `remaining` count once, for the confirmation message
  /// shown right after the click; nothing persists it and no page recomputes
  /// it on load. Only the deletion is unrecoverable, so only the deletion is
  /// recorded — and a frozen copy would go stale the moment a teacher cancels
  /// one of the survivors.
  withdrawnCount  Int?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  teacher     Teacher     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  teacherRoom TeacherRoom @relation(fields: [teacherRoomId], references: [id])
  classes     Class[]
}

/// Carries a partial unique index Prisma cannot express and therefore cannot
/// show: `Class_teacher_slot_unique` on (teacherId, date, startTime) WHERE
/// status <> 'cancelled' (#196). It is invisible to `migrate diff`, so it
/// will not appear as drift and will not be dropped — and equally will not
/// appear in this file unless someone keeps this comment true.
model Class {
  id                   String          @id @default(uuid())
  teacherId            String
  teacherRoomId        String
  templateId           String?
  classType            String
  description          String?         @db.Text
  date                 DateTime        @db.Date
  startTime            String
  durationMinutes      Int
  roomCost             Decimal         @db.Decimal(10, 2)
  minRate              Decimal         @db.Decimal(10, 2)
  targetRate           Decimal         @db.Decimal(10, 2)
  minStudents          Int
  maxStudents          Int
  cancelDeadline       CancelDeadline  @default(HOURS_24)
  autoCancelCheck      AutoCancelCheck @default(HOURS_2)
  status               ClassStatus     @default(draft)
  settingsLocked       Boolean         @default(false)
  effectiveTeacherRate Decimal?        @db.Decimal(10, 2)
  totalStudents        Int?
  totalRevenue         Decimal?        @db.Decimal(10, 2)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  teacher         Teacher         @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  teacherRoom     TeacherRoom     @relation(fields: [teacherRoomId], references: [id])
  template        ClassTemplate?  @relation(fields: [templateId], references: [id], onDelete: SetNull)
  registrations   Registration[]
  waitlistEntries WaitlistEntry[]
  notifications   Notification[]
  announcements   Announcement[]

  @@index([teacherId, date])
  @@unique([templateId, date])
}

/// Carries a partial unique index Prisma cannot express and therefore cannot
/// show: `StudioClassTemplate_teacher_slot_unique` on (teacherId, dayOfWeek,
/// startTime) WHERE isArchived = false (#196). It is invisible to `migrate
/// diff`, so it will not appear as drift and will not be dropped — and
/// equally will not appear in this file unless someone keeps this comment
/// true.
model StudioClassTemplate {
  id              String   @id @default(uuid())
  teacherId       String
  classType       String
  dayOfWeek       Int
  startTime       String
  durationMinutes Int
  location        String
  hourlyRate      Decimal  @db.Decimal(10, 2)
  isActive        Boolean  @default(true)
  isArchived      Boolean  @default(false)

  /// When this template was last archived (#97).
  ///
  /// Null when no archive has recorded one — which is not the same as
  /// `isArchived: false`. `deleteTeacherAccount` (src/services/gdpr.ts) bulk-archives
  /// every studio template of an erased teacher with an `updateMany` that
  /// writes neither this column nor `withdrawnCount`, so `isArchived: true`
  /// with both null is reachable today, as it is for every template archived
  /// before #97 shipped. Read this as "the archive that recorded itself",
  /// never as "is it archived" — `isArchived` answers that.
  ///
  /// Cleared again on un-archive, which forces `isActive: false` in the same
  /// write: what has no withdrawal to report is a template that is no longer
  /// archived, and it is paused at that moment, not live. Re-archiving
  /// overwrites rather than accumulating — a teacher asking what archiving
  /// removed means the archive in force, not every archive this template has
  /// had.
  archivedAt      DateTime?

  /// How many future studio classes that same archive withdrew — the
  /// `deleteMany`'s own returned count, written inside its transaction, so it
  /// cannot claim a number the delete did not produce. Null and cleared on
  /// exactly the terms `archivedAt` above describes, which is what keeps a
  /// recorded `0` ("archived, withdrew nothing") distinguishable from no
  /// record at all.
  ///
  /// Not "unbooked", unlike `ClassTemplate.withdrawnCount`: `StudioClass` has
  /// no registrations to consult, so the only filter is `cancelledAt: null`
  /// and every uncancelled future studio class the boundary reaches is
  /// withdrawn. An already-cancelled one is an income record and survives.
  ///
  /// What is still scheduled is deliberately not stored beside it. The archive
  /// PATCH returns a `remaining` count once, for the confirmation message
  /// shown right after the click; nothing persists it and no page recomputes
  /// it on load. Only the deletion is unrecoverable, so only the deletion is
  /// recorded — and a frozen copy would go stale the moment a teacher cancels
  /// one of the survivors.
  withdrawnCount  Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  teacher       Teacher       @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  studioClasses StudioClass[]
}

/// Carries a partial unique index Prisma cannot express and therefore cannot
/// show: `StudioClass_teacher_slot_unique` on (teacherId, date, startTime)
/// WHERE cancelledAt IS NULL (#196). It is invisible to `migrate diff`, so it
/// will not appear as drift and will not be dropped — and equally will not
/// appear in this file unless someone keeps this comment true.
model StudioClass {
  id              String    @id @default(uuid())
  teacherId       String
  templateId      String?
  classType       String    @default("")
  date            DateTime  @db.Date
  startTime       String
  durationMinutes Int
  location        String
  studentCount    Int?
  hourlyRate      Decimal   @db.Decimal(10, 2)
  cancelledAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  teacher  Teacher              @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  template StudioClassTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@unique([templateId, date])
}

// ============================================================================
// BOOKINGS
// ============================================================================

model Registration {
  id            String             @id @default(uuid())
  classId       String
  studentId     String
  status        RegistrationStatus @default(registered)
  isWalkIn      Boolean            @default(false)
  tierAtBooking Int
  price         Decimal?           @db.Decimal(10, 2)
  tierRatio     Decimal?           @db.Decimal(5, 4)
  registeredAt  DateTime           @default(now())
  cancelledAt   DateTime?
  updatedAt     DateTime           @updatedAt

  class         Class          @relation(fields: [classId], references: [id], onDelete: Cascade)
  student       Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  payment       Payment?
  waitlistEntry WaitlistEntry?

  @@unique([classId, studentId])
  @@index([studentId, status])
}

model WaitlistEntry {
  id             String         @id @default(uuid())
  classId        String
  studentId      String
  position       Int
  status         WaitlistStatus @default(waiting)
  promotedAt     DateTime?
  registrationId String?        @unique
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  class        Class         @relation(fields: [classId], references: [id], onDelete: Cascade)
  student      Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  registration Registration? @relation(fields: [registrationId], references: [id])

  @@unique([classId, studentId])
  @@index([classId, position])
}

// ============================================================================
// PAYMENTS
// ============================================================================

model Payment {
  id             String        @id @default(uuid())
  registrationId String        @unique
  amount         Decimal       @db.Decimal(10, 2)
  status         PaymentStatus @default(pending)
  method         String?
  processorRef   String?
  reminderSentAt DateTime?
  paidAt         DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
}

// ============================================================================
// COMMUNICATION
// ============================================================================

model Notification {
  id             String           @id @default(uuid())
  recipientType  RecipientType
  recipientId    String
  type           NotificationType
  title          String
  body           String           @db.Text
  relatedClassId String?
  isRead         Boolean          @default(false)
  emailSent      Boolean          @default(false)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  relatedClass Class? @relation(fields: [relatedClassId], references: [id], onDelete: SetNull)

  @@index([recipientType, recipientId, isRead])
}

model Announcement {
  id             String   @id @default(uuid())
  teacherId      String
  classId        String?
  message        String   @db.Text
  recipientCount Int
  sentAt         DateTime @default(now())

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  class   Class?  @relation(fields: [classId], references: [id], onDelete: SetNull)
}

// ============================================================================
// AUTH
// ============================================================================

model Session {
  id        String   @id
  accountId String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([accountId])
}

model MagicLinkToken {
  id         String   @id @default(uuid())
  tokenHash  String   @unique
  email      String
  redirectTo String?
  expiresAt  DateTime
  createdAt  DateTime @default(now())
}

model PasskeyCredential {
  id         String   @id
  accountId  String
  publicKey  Bytes
  counter    BigInt
  transports String[]
  createdAt  DateTime @default(now())

  @@index([accountId])
}

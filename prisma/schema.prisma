generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

enum ReminderPref {
  morning_of
  evening_before
  one_hour_before
}

enum PaymentLevel {
  LEVEL_1
  LEVEL_2
}

enum ProcessorType {
  mollie
  stripe
}

enum StudentReminderPref {
  eve
  morning
  one_hour
  off
}

enum CancelDeadline {
  HOURS_48
  HOURS_24
  HOURS_12
  HOURS_6
}

enum AutoCancelCheck {
  HOURS_4
  HOURS_2
  HOURS_1
}

enum ClassStatus {
  draft
  open
  in_progress
  completed
}

enum RegistrationStatus {
  registered
  attended
  no_show
  late_cancel
  cancelled
}

enum WaitlistStatus {
  waiting
  promoted
  claimed
  expired
  removed
}

enum PaymentStatus {
  pending
  paid
  overdue
}

enum RecipientType {
  teacher
  student
}

enum NotificationType {
  booking_confirmed
  class_cancelled
  payment_received
  payment_request
  waitlist_promoted
  spot_available
  reminder
  missed_you
  announcement
  teacher_invitation
}

enum InvitationStatus {
  pending
  accepted
  declined
}

// ============================================================================
// PEOPLE
// ============================================================================

// One account per human: owns the authenticated email identity, sessions,
// and passkeys. Teacher/Student are profiles optionally hanging off it —
// only the two profile-link columns reference Account; everything else in
// the domain keys on teacherId/studentId (auth unifies, domain doesn't).
// Profile email columns are denormalized copies set at link time; live
// linked profiles match the account's email by construction, and there is
// deliberately no email-change flow — adding one must update the account
// and its live linked profiles together, through a single choke point.
model Account {
  id        String   @id @default(uuid())
  email     String   @unique
  createdAt DateTime @default(now())

  teacher Teacher?
  student Student?
}

model Teacher {
  id                 String         @id @default(uuid())
  accountId          String         @unique
  firstName          String
  lastName           String
  email              String         @unique
  photoUrl           String?
  bio                String         @db.VarChar(250)
  pageSlug           String         @unique
  customDomain       String?
  defaultCurrency    String         @default("EUR")
  defaultTimezone    String         @default("Europe/Amsterdam")
  defaultReminder    ReminderPref   @default(morning_of)
  paymentLevel       PaymentLevel   @default(LEVEL_1)
  bankIban           String?
  bankAccountName    String?
  processorType      ProcessorType?
  processorAccountId String?
  deletedAt          DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  account         Account          @relation(fields: [accountId], references: [id])
  teacherRooms    TeacherRoom[]
  calendarEntries CalendarEntry[]
  announcements   Announcement[]
  studentPrivacy  StudentPrivacy[]
  createdRooms    Room[]           @relation("RoomCreator")
  teacherStudents TeacherStudent[]
  invitations     Invitation[]
  teacherBlocks   TeacherBlock[]
  scheduleRules   ScheduleRule[]
}

model Student {
  id                 String              @id @default(uuid())
  // Nullable: CRM-created students stay unclaimed (claimedAt null) until
  // the human authenticates — the claim moment links the account.
  accountId          String?             @unique
  firstName          String
  lastName           String
  email              String              @unique
  incomeTier         Int                 @default(3)
  phone              String?
  birthday           DateTime?           @db.Date
  address            String?
  reminderPref       StudentReminderPref @default(morning)
  emailNotifications Boolean             @default(true)
  claimedAt          DateTime?
  tierSelectedAt     DateTime?
  deletedAt          DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  account         Account?         @relation(fields: [accountId], references: [id])
  registrations   Registration[]
  waitlistEntries WaitlistEntry[]
  studentPrivacy  StudentPrivacy[]
  teacherStudents TeacherStudent[]
}

model StudentPrivacy {
  id            String   @id @default(uuid())
  studentId     String
  teacherId     String
  shareFullName Boolean  @default(false)
  shareEmail    Boolean  @default(false)
  sharePhone    Boolean  @default(false)
  shareBirthday Boolean  @default(false)
  shareAddress  Boolean  @default(false)
  receiveComms  Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([studentId, teacherId])
}

model TeacherStudent {
  id         String   @id @default(uuid())
  teacherId  String
  studentId  String
  isArchived Boolean  @default(false)
  createdAt  DateTime @default(now())

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([teacherId, studentId])
}

// A teacher's CRM contact and its consent state. Deliberately NOT a
// Student row: POST /api/students must behave identically whether or not
// the address is already on the platform, and it cannot, if it writes to
// a table with a unique email column.
model Invitation {
  id          String           @id @default(uuid())
  teacherId   String
  email       String
  firstName   String           @default("")
  lastName    String           @default("")
  status      InvitationStatus @default(pending)
  isArchived  Boolean          @default(false)
  createdAt   DateTime         @default(now())
  respondedAt DateTime?

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([teacherId, email])
  @@index([email])
}

// A student's standing refusal of one teacher, kept out of `Invitation` on
// purpose. Held here, invitation rows behave identically for a blocked and
// an unblocked address — listed, edited, archived, deleted, re-created — so
// there is no observable difference for a teacher to read. Held *in* the
// invitation row, every one of those operations needs a special case, and
// each is a place the block can be silently lost.
model TeacherBlock {
  id        String   @id @default(uuid())
  teacherId String
  email     String
  createdAt DateTime @default(now())

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([teacherId, email])
}

// ============================================================================
// SPACES
// ============================================================================

/// Carries two partial unique indexes Prisma cannot express and therefore
/// cannot show: `Room_public_identity_unique` on (address, floor, roomName)
/// WHERE isPublic = true, and `Room_private_identity_unique` on
/// (createdById, address, floor, roomName) WHERE isPublic = false (#196).
/// Both are invisible to `migrate diff`, so neither will appear as drift and
/// neither will be dropped — and equally neither will appear in this file
/// unless someone keeps this comment true.
model Room {
  id          String   @id @default(uuid())
  venueName   String
  address     String
  city        String
  postcode    String
  floor       String   @default("")
  roomName    String   @default("")
  maxCapacity Int
  equipment   Json     @default("[]")
  notes       String?  @db.Text
  isPublic    Boolean  @default(false)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy    Teacher       @relation("RoomCreator", fields: [createdById], references: [id])
  teacherRooms TeacherRoom[]

  @@index([address, floor, roomName])
}

model TeacherRoom {
  id               String   @id @default(uuid())
  teacherId        String
  roomId           String
  capacityOverride Int
  rentalRate       Decimal  @db.Decimal(10, 2)
  equipmentNotes   String?  @db.Text
  isArchived       Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  teacher        Teacher         @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  room           Room            @relation(fields: [roomId], references: [id], onDelete: Cascade)
  classTemplates ClassTemplate[]
  classes        Class[]

  @@unique([teacherId, roomId])
  @@unique([id, isArchived])
}

// ============================================================================
// CLASSES
// ============================================================================

/// Since #298, carries neither a slot index nor a trigger: the calendar
/// identity that `ClassTemplate_teacher_slot_unique` and the two
/// `class_template_cross_family_slot_*_guard` triggers used to enforce moved
/// to `ScheduleRule`, whose own docblock carries the `EXCLUDE USING gist`
/// that replaced them.
///
/// What Prisma cannot show here instead: `ClassTemplate_kind_check`, `CHECK
/// ("kind" = 'regular')`. Paired with `StudioClassTemplate`'s own `'studio'`
/// check below, it is what makes the composite foreign key
/// `(scheduleRuleId, kind) → ScheduleRule(id, kind)` mean "regular children
/// hang off regular rules" — not merely "the pair agrees".
model ClassTemplate {
  id              String          @id @default(uuid())
  scheduleRuleId  String          @unique
  kind            ClassFamily
  teacherRoomId   String

  /// MIRRORS. Neither column is state this row owns, and neither may disagree
  /// with the parent it mirrors — but they are not written the same way.
  /// `ruleLive` is maintained by Postgres alone; `roomArchived` is written by
  /// the create and move paths in `class-template-lifecycle.ts`, which assert
  /// or copy the room's value, and Postgres is what refuses them if they lie.
  ///
  /// `ruleLive` mirrors `ScheduleRule.live`; `roomArchived` mirrors
  /// `TeacherRoom.isArchived`. Neither can drift from what it mirrors, and that
  /// is enforced rather than intended: each is one column of a composite foreign
  /// key whose remaining columns are the parent's key, so a row claiming a value
  /// its parent does not hold is refused with `23503` instead of stored, and
  /// `ON UPDATE CASCADE` rewrites every mirroring child in the same statement
  /// that changes the parent.
  ///
  /// They exist so a predicate spanning three tables can be checked against one
  /// row. That check is `ClassTemplate_live_needs_open_room`,
  /// `CHECK (NOT ("ruleLive" AND "roomArchived"))`, hand-authored in the
  /// migration because Prisma cannot express it — the constraint that makes "an
  /// active template may not sit on an archived room" unrepresentable rather
  /// than merely guarded (issue 272).
  ///
  /// THIS IS NOT #298 BEING UNDONE. #298 moved the OWNERSHIP of
  /// `ClassTemplate.isActive`/`.isArchived` to `ScheduleRule`, and that is
  /// still the only place either is written. (Said explicitly because the
  /// column this docblock is about mirrors a DIFFERENT `isArchived` —
  /// `TeacherRoom`'s, which `setTeacherRoomArchived` owns.) What sits here is a copy the database maintains. Removing these
  /// columns to "finish" #298 removes the invariant with them.
  ruleLive        Boolean         @default(true)
  roomArchived    Boolean         @default(false)
  description     String?         @db.Text
  roomCost        Decimal         @db.Decimal(10, 2)
  minRate         Decimal         @db.Decimal(10, 2)
  targetRate      Decimal         @db.Decimal(10, 2)
  minStudents     Int
  maxStudents     Int
  cancelDeadline  CancelDeadline  @default(HOURS_24)
  autoCancelCheck AutoCancelCheck @default(HOURS_2)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  scheduleRule ScheduleRule @relation(fields: [scheduleRuleId, kind, ruleLive], references: [id, kind, live], onDelete: Cascade)
  teacherRoom  TeacherRoom  @relation(fields: [teacherRoomId, roomArchived], references: [id, isArchived])
}

/// Since #327, carries neither a slot index nor a cross-family trigger: the
/// calendar identity that `Class_teacher_slot_unique` and the
/// `class_cross_family_slot_*_guard` triggers used to enforce moved to
/// `CalendarEntry`, whose own docblock carries the `EXCLUDE USING gist` that
/// replaced them. Cancellation moved with it — a cancelled class is one whose
/// entry has a `cancelledAt`, not a `status`.
///
/// What Prisma cannot show here instead, none of it visible to
/// `migrate diff` and therefore none of it ever showing as drift — and equally
/// none of it reappearing if this list stops being kept. RE-DERIVE THE SET
/// rather than trusting the list below; only the annotations need prose, and
/// the same query answers for `CalendarEntry` with its own table name:
///
///     SELECT conname FROM pg_constraint c JOIN pg_class t ON t.oid = c.conrelid
///      WHERE t.relname = 'Class' AND c.contype IN ('c', 'x')
///     UNION ALL
///     SELECT tgname FROM pg_trigger g JOIN pg_class t ON t.oid = g.tgrelid
///      WHERE t.relname = 'Class' AND NOT g.tgisinternal;
///
///   - `Class_kind_check`, `CHECK ("kind" = 'regular')`. Paired with
///     `StudioClass`'s own `'studio'` check below, it is what makes the
///     composite foreign key `(calendarEntryId, kind) → CalendarEntry(id,
///     kind)` mean "regular children hang off regular entries" — not merely
///     "the pair agrees".
///   - `class_terminal_status_guard`, which refuses any status change on a
///     terminal class.
///   - `class_sync_entry_completed_guard` and
///     `class_sync_entry_completed_insert_guard`, TWO triggers running the one
///     function `class_sync_entry_completed`, which writes
///     `CalendarEntry.classCompletedAt` when a class completes. One per event,
///     and the INSERT half is not redundant: the UPDATE trigger is
///     `AFTER UPDATE OF status`, so a `Class` inserted already at
///     `status = 'completed'` fired nothing and left its entry unmarked and
///     its `date` editable — which is the guarantee `waitlist-retention.ts`
///     permanently DELETEs queue rows on the strength of.
///     `20260826140000_entry_guard_restorations` carries why it is a second
///     trigger rather than a widened first. That marker is also what lets the
///     entry's freeze guard read only its own row instead of reaching back
///     here for a status — see the field's docblock on `CalendarEntry` for the
///     lock-order argument.
model Class {
  id                   String          @id @default(uuid())
  calendarEntryId      String          @unique
  kind                 ClassFamily
  teacherRoomId        String
  description          String?         @db.Text
  roomCost             Decimal         @db.Decimal(10, 2)
  minRate              Decimal         @db.Decimal(10, 2)
  targetRate           Decimal         @db.Decimal(10, 2)
  minStudents          Int
  maxStudents          Int
  cancelDeadline       CancelDeadline  @default(HOURS_24)
  autoCancelCheck      AutoCancelCheck @default(HOURS_2)
  status               ClassStatus     @default(draft)
  settingsLocked       Boolean         @default(false)
  effectiveTeacherRate Decimal?        @db.Decimal(10, 2)
  totalStudents        Int?
  totalRevenue         Decimal?        @db.Decimal(10, 2)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  /// When the first-come-first-claimed broadcast last went out for the seat
  /// that is currently free — null when no broadcast stands for it (#220).
  ///
  /// Not "when a broadcast last happened". What invalidates a broadcast is not
  /// time passing but a seat being FILLED, so `activateRegistration`
  /// (services/waitlist.ts) clears this and `handleSpotFreed`'s broadcast
  /// branch sets it. Every seat fill in the app funnels through that one
  /// function — direct booking, `promoteNext`, `claimSpot` — and all three of
  /// its callers already hold this row's `FOR UPDATE` lock, which is what
  /// serializes the clear against the set.
  ///
  /// This replaced a gate that asked "does a `spot_available` notification
  /// exist in the current claim window". That question is a proxy, and it
  /// answered wrong for the sequence the sweep exists to repair: seat frees,
  /// broadcast succeeds, a waiter claims, the seat frees AGAIN, and the live
  /// hook drops the second broadcast. The window still held the first
  /// notification, so the reconciliation sweep suppressed itself for the rest
  /// of the hour and the remaining waiters were never told. A null check
  /// cannot make that mistake, because a claim clears it.
  spotBroadcastAt DateTime?

  calendarEntry   CalendarEntry   @relation(fields: [calendarEntryId, kind], references: [id, kind], onDelete: Cascade)
  teacherRoom     TeacherRoom     @relation(fields: [teacherRoomId], references: [id])
  registrations   Registration[]
  waitlistEntries WaitlistEntry[]
  notifications   Notification[]
  announcements   Announcement[]
}

/// Since #298, carries neither a slot index nor a trigger: the calendar
/// identity that `StudioClassTemplate_teacher_slot_unique` and the two
/// `studio_class_template_cross_family_slot_*_guard` triggers used to enforce
/// moved to `ScheduleRule`, whose own docblock carries the `EXCLUDE USING
/// gist` that replaced them.
///
/// What Prisma cannot show here instead: `StudioClassTemplate_kind_check`,
/// `CHECK ("kind" = 'studio')`. Paired with `ClassTemplate`'s own `'regular'`
/// check above, it is what makes the composite foreign key
/// `(scheduleRuleId, kind) → ScheduleRule(id, kind)` mean "studio children
/// hang off studio rules" — not merely "the pair agrees".
model StudioClassTemplate {
  id             String      @id @default(uuid())
  scheduleRuleId String      @unique
  kind           ClassFamily
  location       String
  hourlyRate     Decimal     @db.Decimal(10, 2)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  scheduleRule ScheduleRule @relation(fields: [scheduleRuleId, kind], references: [id, kind], onDelete: Cascade)
}

/// The discriminator both layers share: `ScheduleRule` holds the recurring
/// rule, `CalendarEntry` the dated entry, and each has one child table per
/// family hanging off it by `(parentId, kind)`.
///
/// A child table's own `kind` column is not enough to make such a foreign key
/// mean "this family's children hang off this family's parents" — without
/// more, it only means "the pair agrees", which a row of the wrong family
/// could still satisfy by carrying its own `kind` alongside it. What closes
/// that gap is a `CHECK ("kind" = '<this table's literal>')` on the child
/// table, invisible to Prisma and therefore hand-authored in the migration
/// rather than declared here; each child model's docblock records where its
/// own lives.
///
/// So any new child of either parent — and a future variant of this enum —
/// needs that CHECK, or the composite key it joins through means less than it
/// appears to.
enum ClassFamily {
  regular
  studio
}

/// The calendar identity shared by the two template families (#298).
///
/// Carries TWO constraints this file cannot express, both hand-authored in the
/// migration and both invisible to `migrate diff` — so neither shows as drift,
/// and equally neither reappears if this list stops being kept:
///
///   - an `EXCLUDE USING gist` over a generated `slot` column;
///     `docs/lock-order.md` carries the argument.
///   - `ScheduleRule_duration_positive`, `CHECK ("durationMinutes" > 0)`.
model ScheduleRule {
  id              String      @id @default(uuid())
  teacherId       String
  kind            ClassFamily
  classType       String
  dayOfWeek       Int
  startTime       DateTime    @db.Time
  durationMinutes Int

  /// The generated occupancy range. Declared so `prisma migrate dev` does not
  /// read it as drift; `Unsupported` keeps it out of the generated client, so
  /// it can be neither read nor written from TypeScript.
  slot Unsupported("int4range")? @default(dbgenerated())

  isActive   Boolean @default(true)
  isArchived Boolean @default(false)

  /// Rule liveness as a stored generated column: exactly the predicate
  /// `ACTIVE_TEMPLATE_WHERE` (`src/lib/template-selection.ts`) applies to a row
  /// set, computed per row so a foreign key can reference it.
  ///
  /// `NOT NULL` is load-bearing and not tidiness. A generated column is nullable
  /// unless declared otherwise, Prisma's `Boolean` is required, and the mismatch
  /// is drift — `prisma migrate diff --exit-code`, the required CI check, fails
  /// on it. `docs/lock-order.md` carries the argument for the constraint this
  /// column serves.
  ///
  /// Prisma exposes it as a writable field and the database refuses every write
  /// to it (`428C9`) — measured, not assumed. Nothing in the app writes it.
  live       Boolean @default(dbgenerated())

  /// When this rule was last archived (#97). Issue 298 moved this column
  /// here from `ClassTemplate`/`StudioClassTemplate` — the semantics are
  /// unchanged, and it is now shared by both families through `kind`.
  ///
  /// Null when no archive has recorded one — which is not the same as
  /// `isArchived: false`. `deleteTeacherAccount` (src/services/gdpr.ts)
  /// bulk-archives every rule of an erased teacher with two `updateMany`s
  /// (one per `kind`) that write `{ isActive: false, isArchived: true }` and
  /// nothing else, so `isArchived: true` with both this column and
  /// `withdrawnCount` null is reachable today, as it is for every template
  /// archived before #97 shipped. Read this as "the archive that recorded
  /// itself", never as "is it archived" — `isArchived` answers that.
  ///
  /// Cleared again on un-archive, which forces `isActive: false` in the same
  /// write: what has no withdrawal to report is a rule that is no longer
  /// archived, and it is paused at that moment, not live. Re-archiving
  /// overwrites rather than accumulating — a teacher asking what archiving
  /// removed means the archive in force, not every archive this rule has
  /// had.
  archivedAt DateTime?

  /// How many future classes that same archive withdrew: the owning child's
  /// `deleteMany`'s own returned count, written inside its transaction, so it
  /// cannot claim a number the delete did not produce. Null and cleared on
  /// exactly the terms `archivedAt` above describes, which is what keeps a
  /// recorded `0` ("archived, withdrew nothing") distinguishable from no
  /// record at all.
  ///
  /// What counts as "unbooked" is family-specific, and lives with each
  /// family's own archive function rather than here: for `kind: 'regular'`
  /// (`archiveOrUnarchiveTemplate`, class-template-lifecycle.ts) it means no
  /// registration in a CHARGED status. For `kind: 'studio'`
  /// (`archiveOrUnarchiveStudioTemplate`, studio-class-template-lifecycle.ts),
  /// `StudioClass` has no registrations to consult, so the filter is
  /// `cancelledAt: null`, and every uncancelled future studio class the
  /// boundary reaches counts as withdrawn — an already-cancelled one
  /// survives, not because it is an income record (it is not: the sole
  /// `studioClass.findMany` in `settings/reporting/page.tsx` queries with
  /// `cancelledAt: null` and excludes it from earnings and the month rollup
  /// outright), but because its entry holds `(scheduleRuleId, date)`, and a
  /// date the teacher cancelled deliberately must not be refilled on the next
  /// resume.
  ///
  /// What is still scheduled is deliberately not stored beside it. The
  /// archive PATCH returns a `remaining` count once, for the confirmation
  /// message shown right after the click; nothing persists it and no page
  /// recomputes it on load. Only the deletion is unrecoverable, so only the
  /// deletion is recorded — and a frozen copy would go stale the moment a
  /// teacher cancels one of the survivors.
  withdrawnCount Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  teacher              Teacher               @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  // Plural despite 0-or-1 cardinality, matching every other array relation in
  // this schema (`teacherRooms`, `classes`, `TeacherRoom.classTemplates`).
  // Still arrays, not `ClassTemplate?`: Prisma requires a `@@unique` matching
  // the exact [scheduleRuleId, kind] field pair to model a to-one
  // back-relation, and the DB constraint the migration installs is `UNIQUE
  // (scheduleRuleId)` alone (Prisma's own naming convention for
  // `scheduleRuleId String @unique`) — adding a second, redundant composite
  // unique index just to satisfy the relation shape has no DB reason to
  // exist. Runtime cardinality is still 0-or-1, enforced by that
  // single-column constraint.
  classTemplates       ClassTemplate[]
  studioClassTemplates StudioClassTemplate[]
  calendarEntries      CalendarEntry[]

  @@unique([id, kind])
  @@unique([id, kind, live])
  @@index([teacherId, dayOfWeek])
}

/// The calendar identity shared by the two entry families (#327): when a
/// teacher is teaching, and for how long. `Class` and `StudioClass` keep only
/// their own economics and hang off this by a composite foreign key.
///
/// Carries constraints AND triggers this file cannot express, all
/// hand-authored in the migrations and all invisible to `migrate diff` — so
/// none shows as drift, and equally none reappears if this list stops being
/// kept. Same scope as `Class`'s list above, and re-derived by the same query
/// with `'CalendarEntry'` for `'Class'`; run it rather than trusting the list:
///
///   - `CalendarEntry_teacher_slot_excl`, an `EXCLUDE USING gist` over the
///     generated `span` column below. It is what replaced the two partial
///     slot indexes and the four cross-family triggers of #296 — one range
///     constraint, index-backed and race-free by construction, where those
///     were a per-table key plus an unlocked cross-table read. `docs/lock-order.md` carries the argument.
///   - `CalendarEntry_duration_positive`, `CHECK ("durationMinutes" > 0)`.
///     It is the ZERO case that needs it, and quietly: `tsrange(t, t, '[)')`
///     is EMPTY, an empty range `&&` overlaps nothing, so a zero-duration
///     entry would sit outside the constraint above entirely and take no slot
///     at all. A negative duration needs no guarding — the generated column's
///     own expression raises `range lower bound must be less than or equal to
///     range upper bound` before any constraint is consulted. Both measured.
///   - `CalendarEntry_completion_marker_regular_only`,
///     `CHECK ("kind" = 'regular' OR "classCompletedAt" IS NULL)`. The
///     AUTHORSHIP half of `classCompletedAt`'s contract, which the trigger
///     beside it enforces nothing of — see that column's own comment.
///   - `CalendarEntry_not_cancelled_and_completed`,
///     `CHECK (NOT ("classCompletedAt" IS NOT NULL AND "cancelledAt" IS NOT
///     NULL))`. Cancelled and completed are mutually exclusive, and this is
///     the invariant the extraction made expressible: both markers are columns
///     of one row now, so it needs no cross-table read.
///     `20260826200000_entry_marker_exclusivity` carries both, with the
///     argument for each.
///   - `entry_frozen_schedule_guard`, which refuses a `date`, `startTime` or
///     `durationMinutes` change on a terminal entry — the freeze
///     `waitlist-retention.ts` rests on.
///   - `entry_completion_marker_guard`, which makes `classCompletedAt`
///     write-once, so the freeze above cannot be walked around by clearing its
///     own input first.
///   - `entry_terminal_liveness_guard`, which refuses to un-cancel a regular
///     entry and refuses to cancel a completed one — the arms of
///     `CalendarEntry_not_cancelled_and_completed` that can be expressed
///     against the row being written.
///
/// The three guards' own functions are named
/// `entry_reject_frozen_schedule_change`,
/// `entry_reject_completion_marker_change` and
/// `entry_reject_terminal_liveness_change`; the query above returns the
/// TRIGGER names, which is what `pg_trigger` and the migrations spell.
model CalendarEntry {
  id        String      @id @default(uuid())
  teacherId String
  kind      ClassFamily

  /// A STAMP, not a live link — the same rule CLAUDE.md states for the whole
  /// template relationship, and this is the field it is easiest to forget it
  /// about. The generator COPIES `ScheduleRule.classType` here at generation
  /// time and nothing rewrites it afterwards, so renaming a recurring class
  /// diverges the two on purpose: every entry already generated keeps the name
  /// the rule carried when it was made, and only entries generated after the
  /// edit carry the new one.
  ///
  /// Which of the two to read is therefore a question about what is being
  /// labelled, and it has one answer each way. This column is what THIS class
  /// was called — right for a class card, a booking, a payment, an
  /// announcement, anything describing the occasion itself. Reaching the
  /// template's own identity means going through `scheduleRule`, because that
  /// is the only value that tracks the rule as it stands now.
  ///
  /// Read the wrong one and the bug is quiet, which is why this paragraph
  /// exists rather than a comment at a call site: `studio-class/[id]/page.tsx`
  /// labelled its LINK TO THE TEMPLATE with the entry's copy, so after a
  /// rename the link to the template showed the class's old name and nothing
  /// failed. Fixed under #327; the same shape reached `startTime` and was
  /// caught in PR #295's review.
  classType       String
  date            DateTime @db.Date
  startTime       DateTime @db.Time
  durationMinutes Int

  /// Liveness, for both families. A cancelled entry releases its SLOT (the
  /// exclusion constraint is partial on this) but keeps its DATE against the
  /// hourly sweep, so a date a teacher cancelled is not refilled.
  ///
  /// One column where there were two spellings: `Class.status = 'cancelled'`
  /// and `StudioClass.cancelledAt` both ended here. What each family does with
  /// a cancellation still differs and still lives with that family — a `Class`
  /// cancellation is terminal, a `StudioClass` one is reversible, and #279's
  /// cancel-versus-remove rule is in `studio-class-deletion.ts`.
  cancelledAt DateTime?

  /// The owning class completed. Written ONLY by `class_sync_entry_completed`
  /// — a marker synced by application code would miss a
  /// raw `UPDATE "Class" SET status='completed'`, which is the client the
  /// trigger exists to reach.
  ///
  /// THAT IS ENFORCED, not conventional — and it takes TWO OBJECTS, because
  /// each covers a half the other structurally cannot. This is a plain
  /// nullable `DateTime` in the generated client, so
  /// `prisma.calendarEntry.update({ data: { classCompletedAt: null } })`
  /// type-checks.
  ///
  /// `entry_completion_marker_guard`
  /// (`20260826182710_entry_completion_marker_guard`) makes the column
  /// WRITE-ONCE: every departure from a set value is a 409 rather than a
  /// cleared marker. Why it has to be: `entry_frozen_schedule_guard` is
  /// `BEFORE UPDATE OF date, "startTime", "durationMinutes"` and reads `OLD`
  /// here, so clearing this column in one statement unfroze the schedule in the
  /// next — and `waitlist-retention.ts` permanently DELETES on the strength of
  /// that freeze.
  ///
  /// What that guard does NOT enforce is AUTHORSHIP. Its body is
  /// `IF OLD."classCompletedAt" IS NOT NULL THEN RAISE`, so NULL → NOT NULL
  /// passes for any client, and it is `BEFORE UPDATE OF` — an INSERT carrying a
  /// marker fires it not at all. `CalendarEntry_completion_marker_regular_only`
  /// (`20260826200000_entry_marker_exclusivity`) is the static CHECK that
  /// closes the family half of it on both events: a `kind = 'studio'` entry can
  /// never carry a marker, so a stray stamp can no longer freeze a class whose
  /// cancellation is reversible, nor make a never-completed class's queue rows
  /// reapable.
  ///
  /// Two triggers stamp it, both running that one function: `AFTER UPDATE OF
  /// status` and, since `20260826140000_entry_guard_restorations`, `AFTER
  /// INSERT`. The UPDATE half alone recorded a TRANSITION rather than a state,
  /// so a row INSERTed already carrying `status = 'completed'` produced no
  /// marker and left its entry's date, start time and duration editable. That
  /// was the HOLE: what `waitlist-retention.ts` rests on when it permanently
  /// deletes queue rows is the freeze, so a completed class whose entry was
  /// never marked is one the sweep can still see move under it. The INSERT
  /// trigger closes it; the migration's own comment carries why it is a
  /// second trigger rather than a widened `WHEN`.
  ///
  /// Stamping twice is a no-op: the function writes only where
  /// `classCompletedAt IS NULL`.
  ///
  /// A marker rather than a read, for lock order: a guard here that consulted
  /// `Class.status` would acquire Entry then Class, against `lockClassRow`'s
  /// Class then Entry. The trigger writes in the completing transaction and
  /// acquires Class then Entry, which composes. See `docs/lock-order.md`.
  ///
  /// Populated for `kind = 'regular'` only, because only that family has a
  /// `status` — and since `20260826200000_entry_marker_exclusivity` that is a
  /// CONSTRAINT rather than a consequence. It is not a gap either way: the
  /// freeze's cancel half is expressed directly from `kind` and `cancelledAt`
  /// in `entry_frozen_schedule_guard`, and a cancelled STUDIO entry is
  /// deliberately not frozen — that cancellation is reversible.
  ///
  /// NEVER SET ALONGSIDE `cancelledAt`, likewise a constraint
  /// (`CalendarEntry_not_cancelled_and_completed`, same migration). Cancelled
  /// and completed are mutually exclusive states of one class, and expressing
  /// that took the extraction: before it, liveness lived on `Class.status` and
  /// completion on the same column, so the pair was unreachable by
  /// construction — then #327 split them across two tables and the invariant
  /// briefly had nowhere to sit. Both are columns of THIS row, so it is a
  /// single-row CHECK.
  ///
  /// Not a general "is this row editable" flag. #276's studio editability rule
  /// is date-derived and lives in `studio-class-editability.ts`.
  classCompletedAt DateTime?

  /// The rule that generated this entry; null for a one-off. Unique with
  /// `date`, which is what holds a generated date against the hourly sweep.
  ///
  /// THE ONLY SINGLE-COLUMN EDGE INTO A KIND-DISCRIMINATED PARENT, and that is
  /// deliberate rather than an oversight. Five foreign keys reach
  /// `ScheduleRule` or `CalendarEntry`; the other four
  /// (`ClassTemplate`, `StudioClassTemplate`, `Class`, `StudioClass`) all go
  /// `(parentId, kind)` → `(id, kind)`, which is what makes them mean "this
  /// family's children hang off this family's parents". This one carries no
  /// `kind`, so nothing in the database stops a `regular` entry pointing at a
  /// `studio` rule.
  ///
  /// WHY IT CANNOT SIMPLY BE WIDENED: this edge is `ON DELETE SET NULL`, and
  /// on a composite foreign key that nulls EVERY referencing column — `kind`
  /// included, which is `NOT NULL`. Archiving a rule would then fail on its own
  /// cascade. PostgreSQL 15 added the column-list form
  /// (`ON DELETE SET NULL ("scheduleRuleId")`) that would fix exactly this, and
  /// this project runs 16.12, so the database can express it; Prisma's schema
  /// language cannot, and this file is what generates the migration.
  ///
  /// WHAT KEEPS IT SOUND TODAY IS A PROPERTY OF THE GENERATORS, NOT OF THE
  /// SCHEMA — which is the half that can stop being true without anything
  /// here changing. Both writers (`class-generator.ts`,
  /// `studio-class-generator.ts`) take `scheduleRuleId` from a template row
  /// they already hold, and that template reaches its rule through the
  /// composite key above, so the rule's `kind` is already pinned to the same
  /// literal the entry is being created with. No mismatched pair is reachable
  /// by any path that exists now.
  ///
  /// That guarantee expires the moment a writer sets `scheduleRuleId` WITHOUT
  /// routing through a template — a backfill, an import, a repair script, or a
  /// future family that attaches entries to rules directly. Anyone writing one
  /// is standing here: check the rule's `kind` against the entry's yourself,
  /// because nothing below will. Tracked as issue 328, which carries that
  /// trigger condition and the measurement the real fix needs.
  scheduleRuleId String?

  /// The generated occupancy range. Declared so `prisma migrate dev` does not
  /// read it as drift; `Unsupported` keeps it out of the generated client, so
  /// it can be neither read nor written from TypeScript.
  span Unsupported("tsrange")? @default(dbgenerated())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teacher       Teacher       @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  scheduleRule  ScheduleRule? @relation(fields: [scheduleRuleId], references: [id], onDelete: SetNull)
  // Plural despite 0-or-1 cardinality, for the reason `ScheduleRule`'s own
  // comment on `classTemplates` gives: Prisma needs a `@@unique` on the exact
  // [calendarEntryId, kind] field pair to model a to-one back-relation, and
  // the constraint the migration installs is `UNIQUE (calendarEntryId)`
  // alone. Runtime cardinality is still 0-or-1, enforced by that
  // single-column constraint.
  classes       Class[]
  studioClasses StudioClass[]

  @@unique([id, kind])
  @@unique([scheduleRuleId, date])
  @@index([teacherId, date])
}

/// Since #327, carries neither a slot index nor a cross-family trigger, and no
/// liveness column of its own: the calendar identity that
/// `StudioClass_teacher_slot_unique` and the
/// `studio_class_cross_family_slot_*_guard` triggers used to enforce moved to
/// `CalendarEntry`, and `cancelledAt` went with it. Both families now spell
/// liveness once, as `CalendarEntry.cancelledAt`.
///
/// What Prisma cannot show here instead, and what `migrate diff` therefore
/// never reports as drift: `StudioClass_kind_check`, `CHECK ("kind" =
/// 'studio')`. Paired with `Class`'s own `'regular'` check above, it is what
/// makes the composite foreign key `(calendarEntryId, kind) →
/// CalendarEntry(id, kind)` mean "studio children hang off studio entries" —
/// not merely "the pair agrees".
model StudioClass {
  id              String      @id @default(uuid())
  calendarEntryId String      @unique
  kind            ClassFamily
  location        String
  studentCount    Int?
  hourlyRate      Decimal     @db.Decimal(10, 2)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  calendarEntry CalendarEntry @relation(fields: [calendarEntryId, kind], references: [id, kind], onDelete: Cascade)
}

// ============================================================================
// BOOKINGS
// ============================================================================

model Registration {
  id            String             @id @default(uuid())
  classId       String
  studentId     String
  status        RegistrationStatus @default(registered)
  isWalkIn      Boolean            @default(false)
  tierAtBooking Int
  price         Decimal?           @db.Decimal(10, 2)
  tierRatio     Decimal?           @db.Decimal(5, 4)
  registeredAt  DateTime           @default(now())
  cancelledAt   DateTime?
  updatedAt     DateTime           @updatedAt

  class         Class          @relation(fields: [classId], references: [id], onDelete: Cascade)
  student       Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  payment       Payment?
  waitlistEntry WaitlistEntry?

  @@unique([classId, studentId])
  @@index([studentId, status])
}

model WaitlistEntry {
  id             String         @id @default(uuid())
  classId        String
  studentId      String
  position       Int
  status         WaitlistStatus @default(waiting)
  promotedAt     DateTime?
  registrationId String?        @unique
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  class        Class         @relation(fields: [classId], references: [id], onDelete: Cascade)
  student      Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  registration Registration? @relation(fields: [registrationId], references: [id])

  @@unique([classId, studentId])
  @@index([classId, position])
}

// ============================================================================
// PAYMENTS
// ============================================================================

model Payment {
  id             String        @id @default(uuid())
  registrationId String        @unique
  amount         Decimal       @db.Decimal(10, 2)
  status         PaymentStatus @default(pending)
  method         String?
  processorRef   String?
  reminderSentAt DateTime?
  paidAt         DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
}

// ============================================================================
// COMMUNICATION
// ============================================================================

model Notification {
  id             String           @id @default(uuid())
  recipientType  RecipientType
  recipientId    String
  type           NotificationType
  title          String
  body           String           @db.Text
  relatedClassId String?
  isRead         Boolean          @default(false)
  emailSent      Boolean          @default(false)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  relatedClass Class? @relation(fields: [relatedClassId], references: [id], onDelete: SetNull)

  // No index on `relatedClassId`, deliberately. An earlier commit on this
  // branch added `(relatedClassId, type, createdAt)` to serve the waitlist
  // reconciliation sweep's broadcast gate, which queried this table once per
  // gated class every sixty seconds. `Class.spotBroadcastAt` replaced that
  // query with a field read on a row the sweep had already loaded, so the
  // index now serves nothing — and an unused index on the app's
  // highest-volume table is not free: every notification insert maintains it.
  // The same commit that removed the query dropped the index.
  @@index([recipientType, recipientId, isRead])
}

model Announcement {
  id             String   @id @default(uuid())
  teacherId      String
  classId        String?
  message        String   @db.Text
  recipientCount Int
  sentAt         DateTime @default(now())

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  class   Class?  @relation(fields: [classId], references: [id], onDelete: SetNull)
}

// ============================================================================
// AUTH
// ============================================================================

model Session {
  id        String   @id
  accountId String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([accountId])
}

model MagicLinkToken {
  id         String   @id @default(uuid())
  tokenHash  String   @unique
  email      String
  redirectTo String?
  expiresAt  DateTime
  createdAt  DateTime @default(now())
}

model PasskeyCredential {
  id         String   @id
  accountId  String
  publicKey  Bytes
  counter    BigInt
  transports String[]
  createdAt  DateTime @default(now())

  @@index([accountId])
}

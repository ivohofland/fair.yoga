# Database
# Production only (docker-compose.prod.yml): the Postgres password, from
# which the compose file builds the app's DATABASE_URL. Delete the two
# DATABASE_URL lines below in production. DEPLOYMENT.md §2.
# POSTGRES_PASSWORD=""
DATABASE_URL="postgresql://yoga:yoga_dev_password@localhost:5432/ethical_yoga"
# Local development only: the vitest unit tier runs against this separate
# database (auto-created + migrated on `pnpm test`). Not needed in production.
DATABASE_URL_TEST="postgresql://yoga:yoga_dev_password@localhost:5432/ethical_yoga_test"
# Local development only, worktrees: the port your worktree's dev server runs
# on (allocated by `pnpm run worktree:setup`) — playwright and the integration
# test tier both read this to reach it instead of :3000. Not needed outside a
# worktree.
# INTEGRATION_BASE_URL="http://localhost:3100"

# Auth
PASSKEY_RP_ID="localhost"
PASSKEY_RP_NAME="fair.yoga"

# The admin surface's host and port (#60), for local development. Production
# deletes this line to keep the surface off (every admin page answers 404), or
# sets admin.<your domain> with PASSKEY_RP_ID set to the parent domain so a
# passkey made on the main host signs in here too. The passkey ceremony cannot
# run on admin.localhost locally (Chrome refuses RP ID "localhost" for a
# subdomain).
ADMIN_HOST="admin.localhost:3000"

# Cron — shared secret that authorises a manual call to /api/cron/*
# (`Authorization: Bearer <secret>`). Without it those endpoints fail closed.
# The in-process scheduler does not use it.
CRON_SECRET=""

# The in-process scheduler (jobs: src/lib/scheduler.ts) starts with the
# server and must run in production. "off" is for CI only — see
# DEPLOYMENT.md §5 for what stops when it's set.
# CRON_SCHEDULER="off"

# Email
LETTERMINT_API_TOKEN=""
LETTERMINT_CLASS_ROUTE=""
EMAIL_FROM=""
EMAIL_REPLY_TO=""
# Where the daily degradation digest goes (#157). Required in production: with it unset,
# a degradation event fails the daily-cleanup job instead of reaching a person.
OPERATOR_EMAIL=""

# Push — generate with `pnpm run vapid:keys`. Unset disables push: the
# dispatch sweep retires rows without sending and the settings section says
# push is unavailable. Rotating the key pair silently orphans every existing
# subscription — browsers re-subscribe only when the user turns push on again.
# VAPID_SUBJECT must be a mailto: or https:// URL (e.g. "mailto:ops@fair.yoga").
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Logging (optional) — pino level for server logs: debug | info | warn | error
# LOG_LEVEL="info"

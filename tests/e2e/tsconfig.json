{
  // playwright.config.ts's `tsconfig` option points here: modules reached
  // from an e2e spec import `@/lib/log`, and without this mapping Playwright
  // resolves `server-only` to its throwing default. `paths` in a child
  // tsconfig replaces the parent's rather than merging, so `@/*` is repeated
  // here. The mapping belongs only here, not in the root tsconfig.json: only
  // Playwright needs it — Next's build already resolves `server-only`
  // correctly, and a root mapping doesn't change that.
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["../../src/*"],
      "server-only": ["../../node_modules/server-only/empty.js"]
    }
  }
}

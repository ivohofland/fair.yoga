{
  // Builds `public/embed/v1.js` (scripts/build-embed.mjs). The options that
  // shape the emitted bytes are pinned here; the build test catches any drift.
  "compilerOptions": {
    "target": "es2020",
    "module": "es2020",
    "lib": ["es2020", "dom", "dom.iterable"],
    "types": [],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmitOnError": true,
    "incremental": false,
    "composite": false,
    "declaration": false,
    "sourceMap": false,
    "removeComments": true,
    "importHelpers": false,
    "useDefineForClassFields": false,
    "newLine": "lf",
    "rootDir": "src/embed",
    "outDir": ".embed-build"
  },
  "files": ["src/embed/schedule-widget.ts"]
}
